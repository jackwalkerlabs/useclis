# Set your production origin to enable canonical URLs and a sitemap.
SITE_URL=https://useclis.com
# Optional: used only by npm run refresh for GitHub API rate limits.
# GITHUB_TOKEN=
# Set in your shell for deployments; CI uses the repository variable of this name.
# CLOUDFLARE_ACCOUNT_ID=

# Public repository for CLI submission issues (also the application default).
# Set this to an empty value to offer draft downloads until the repository exists.
PUBLIC_SUBMISSIONS_REPO=jackwalkerlabs/useclis
