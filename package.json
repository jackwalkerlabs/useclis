{
  "name": "useclis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --import tsx --test scripts/*.test.mjs",
    "refresh-data": "node scripts/refresh-data.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name useclis",
    "refresh-activity": "node scripts/refresh-activity.mjs",
    "snapshot-stars": "node scripts/snapshot-stars.mjs",
    "refresh": "npm run refresh-data && npm run refresh-activity && npm run snapshot-stars",
    "check:links": "node scripts/check-links.mjs",
    "build:design-system": "node scripts/build-design-system.mjs",
    "check:design-system": "node scripts/build-design-system.mjs --check && tsc -p design-system/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackwalkerlabs/useclis.git"
  },
  "bugs": {
    "url": "https://github.com/jackwalkerlabs/useclis/issues"
  }
}
