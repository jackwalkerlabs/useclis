---
import { downloadSources, downloadLabels, type DownloadSnapshot } from '../lib/downloads.mjs';
interface Props { downloads: Partial<Record<string, DownloadSnapshot>> }
const { downloads } = Astro.props;
const date = (value: string) => new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
{downloadSources.filter(source => downloads[source]).map(source => {
  const snapshot = downloads[source]!;
  const github = source === 'github';
  const old = snapshot.checkedAt && Date.now() - Date.parse(snapshot.checkedAt) > 7 * 86400000;
  const available = github ? snapshot.total !== null : Object.values(snapshot.counts).some(value => value !== null);
  return <section id={`downloads-${source}`} class="downloads-panel" aria-label={downloadLabels[source]}>
    <div class="downloads-heading"><h2>{downloadLabels[source]}</h2><a href={snapshot.url} target="_blank" rel="noreferrer">{snapshot.package ?? snapshot.repo} ↗</a></div>
    <dl class:list={['downloads-counts', { 'downloads-total': github }]}>
      {github ? <div><dt>Cumulative · selected release binaries</dt><dd>{snapshot.total?.toLocaleString('en-US') ?? <span class="unavailable">Unavailable</span>}</dd></div> : [30, 90, 365].map(days => <div><dt>{days} days</dt><dd>{snapshot.counts[`${days}d`]?.toLocaleString('en-US') ?? <span class="unavailable">Unavailable</span>}</dd></div>)}
    </dl>
    <p>{github ? `Downloads of selected binaries from published, non-prerelease releases${snapshot.assetCount != null ? ` (${snapshot.assetCount} assets across ${snapshot.releaseCount} releases)` : ''}. Excludes source archives, checksums, and signatures. Deleted assets are no longer included. These are cumulative counts, not downloads over the last 30 days.` : source === 'pypi' ? 'Package downloads excluding known mirrors. Includes automated and dependency downloads. Annual counts appear once a complete year of daily data is available.' : 'Package downloads, including automated and dependency downloads. Counts cover the mapped CLI package, excluding separate platform packages.'}</p>
    <p>Downloads are not unique users or confirmed installations. Sources can overlap and should not be added together.</p>
    {snapshot.status === 'error' && <p class="downloads-status">{available ? 'Latest refresh unavailable. Showing the last saved counts.' : 'Download data is currently unavailable.'}</p>}
    {snapshot.status === 'ok' && old && <p class="downloads-status">This saved snapshot is over a week old.</p>}
    <p>{snapshot.checkedAt && <>Checked <time datetime={snapshot.checkedAt}>{date(snapshot.checkedAt)}</time>. </>}{snapshot.end && <> {github ? 'Snapshot' : 'Periods end'} <time datetime={snapshot.end}>{date(snapshot.end)}</time>. </>}<a href="/about/#downloads">How downloads are counted ↗</a></p>
  </section>;
})}
<style>
  .downloads-panel { container-type: inline-size; margin: 28px 0; padding: 22px; border: 1px solid var(--border-subtle); border-radius: 12px; background: white; }
  .downloads-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .downloads-heading h2 { margin: 0; font-size: 20px; }
  .downloads-heading a { font-size: 13px; overflow-wrap: anywhere; }
  .downloads-counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 18px 0; }
  .downloads-total { grid-template-columns: 1fr; }
  .downloads-counts dt { font-size: 12px; color: var(--text-muted); margin-bottom: 5px; }
  .downloads-counts dd { margin: 0; font: 600 clamp(16px, 4.5cqi, 24px)/1.3 var(--font-mono); white-space: nowrap; }
  .downloads-panel p { margin: 10px 0 0; font-size: 12px; line-height: 1.6; color: var(--text-muted); }
  .downloads-panel a { color: var(--green-700); }
  .unavailable { font: 12px var(--font-body); color: var(--text-muted); }
  .downloads-panel .downloads-status { color: #8a4d00; }
  @container (max-width: 540px) {
    .downloads-counts { grid-template-columns: 1fr; }
    .downloads-counts > div { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .downloads-counts dd { font-size: 20px; }
    .downloads-total > div { display: block; }
  }
</style>
