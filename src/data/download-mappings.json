  "github-cli": {
    "repo": "cli/cli",
    "github": {
      "assetPattern": "^gh_[0-9][0-9.]*_(?:linux|macOS|windows)_[A-Za-z0-9]+\\.(?:tar\\.gz|zip|deb|rpm|pkg|msi)$",
      "evidence": "https://github.com/cli/cli/releases/latest"
    }
  },
