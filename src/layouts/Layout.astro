---
import '../styles.css';
import '../mobile.css';
import '../submission.css';
import SavedLink from '../components/SavedLink';
import SubmitCLI from '../components/SubmitCLI';
import '../typography.css';
import '../discovery.css';
import '../date-range.css';
import '../agent-prompt.css';
import inconsolataLatin from '../../design-system/assets/fonts/inconsolata-latin-wght.woff2?url';
import { defaultSiteUrl } from '../lib/agent-prompt';
import { defaultShareImage, type ShareImage } from '../lib/social';
interface Props { title?: string; description?: string; active?: string; image?: ShareImage; type?: 'website' | 'article' | 'profile' }
const { title = 'useclis — CLIs for agents', description = 'Discover GitHub-backed command-line tools for AI agents. Search by task, inspect repository activity, and explore CLI commands.', active = 'Directory', image = defaultShareImage, type = 'website' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
// Share previews need absolute URLs; builds without SITE_URL fall back to production.
const shareBase = Astro.site ?? new URL(defaultSiteUrl);
const pageUrl = canonical ?? new URL(Astro.url.pathname, shareBase);
const imageUrl = new URL(image.path, shareBase);
const submissionRepo = import.meta.env.PUBLIC_SUBMISSIONS_REPO?.trim() ?? 'jackwalkerlabs/useclis';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f8" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="useclis" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    <link rel="preload" href={inconsolataLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <div class="container header-inner">
        <a class="wordmark" href="/" aria-label="useclis home"><img src="/favicon.svg" alt="" width="30" height="30" />useclis<span class="wordmark-dot">.</span></a>
        <nav aria-label="Main navigation">
          <a class:list={{ active: active === 'Directory' }} href="/">Directory</a>
          <a class:list={{ active: active === 'Categories' }} href="/categories/">Categories</a>
          <a class:list={{ active: active === 'Owners' }} href="/github/">Owners</a>
          <a class:list={{ active: active === 'About' }} href="/about/">About</a>
        </nav>
        <div class="header-actions"><SavedLink client:load /><SubmitCLI client:load submissionRepo={submissionRepo} /></div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer container"><div><a href="/" class="wordmark small"><img src="/favicon.svg" alt="" width="23" height="23" />useclis.</a><span>Command-line tools for agents.</span></div><div><a href="/categories/">Categories</a><a href="/about/">About the directory</a><span class="footer-note">Made for the open web <span class="green">↗</span></span></div></footer>
  </body>
</html>
